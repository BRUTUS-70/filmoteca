---
// src/pages/ajustes.astro
import Layout from '../layouts/Layout.astro';
import MenuLateral from '../components/MenuLateral.astro';
export const prerender = false;
---

<Layout title="Ajustes de Cuenta | Filmoteca">
    <MenuLateral modoSecundario={true}>
        <div class="section-label" style="margin-top: 10px;">Ajustes</div>
    </MenuLateral>

    <main>
        <div class="header-bar">
            <h2 class="view-title-main">Mi<span>Perfil</span></h2>
        </div>

        <div class="settings-container">
            
            <section class="settings-box">
                <h3 class="settings-title">Personalización</h3>
                <p class="settings-desc">Elige cómo quieres que te veamos.</p>
                
                <form id="form-profile" onsubmit="window.saveProfile(event)">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                        <div>
                            <label class="input-label">Nombre / Alias</label>
                            <input type="text" id="aj-nombre" class="input-dark" placeholder="Ej: Cinéfilo99" />
                        </div>
                        <div>
                            <label class="input-label">URL Avatar (Opcional)</label>
                            <div id="aj-avatar-preview" style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden; margin-bottom: 10px; display: none; border: 2px solid var(--color-accent);">
                                <img id="aj-avatar-img" src="" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                            <input type="text" id="aj-avatar" class="input-dark" placeholder="Letra autogenerada si vacío" />
                        </div>
                    </div>

                    <div style="text-align: right;">
                        <button type="submit" id="btn-save-profile" class="btn-primary">Guardar Perfil</button>
                    </div>
                </form>
            </section>

            <section class="settings-box">
                <h3 class="settings-title">Seguridad y Acceso</h3>
                <p class="settings-desc">Modifica tu correo electrónico o actualiza tu contraseña de acceso.</p>
                
                <form id="form-security" onsubmit="window.saveSecurity(event)">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                        <div>
                            <label class="input-label">Correo Electrónico</label>
                            <input type="email" id="aj-email" class="input-dark" required />
                            <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 5px;">*Si cambias tu email, puede que debas confirmar el enlace en tu bandeja de entrada.</span>
                        </div>
                        <div>
                            <label class="input-label">Nueva Contraseña</label>
                            <input type="password" id="aj-pass" class="input-dark" placeholder="Dejar en blanco para no cambiar" minlength="6" />
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <button type="button" id="btn-logout-devices" onclick="window.logoutGlobal()" class="btn-secondary">
                            Cerrar sesión en otros dispositivos
                        </button>
                        <button type="submit" id="btn-save-security" class="btn-primary">Actualizar Seguridad</button>
                    </div>
                </form>
            </section>

            <section class="settings-box danger-zone">
                <h3 class="settings-title" style="color: #e74c3c;">Zona de Peligro</h3>
                <p class="settings-desc">Si eliminas tu cuenta, perderás el acceso a la Filmoteca y se borrará tu lista de deseos asociada.</p>
                
                <div style="margin-top: 20px;">
                    <button type="button" id="btn-delete-account-prompt" onclick="window.confirmDeleteAccount()" class="btn-danger">
                        Eliminar mi cuenta
                    </button>
                </div>
            </section>

        </div>
    </main>

    <div id="toast-container" class="toast"></div>

    <div id="confirm-modal" class="modal-overlay" style="z-index: 10000;" onclick="if(event.target === this) window.closeConfirmModal()">
        <div class="modal-content" style="max-width: 420px; width: 90%; padding: 30px; text-align: center; flex-direction: column; align-items: center; box-sizing: border-box; border-color: #e74c3c;">
            <div style="font-size: 3rem; margin-bottom: 15px; line-height: 1;">🚨</div>
            <h3 class="modal-title" style="margin-top: 0; margin-bottom: 10px; font-size: 1.5rem; width: 100%;">¿Eliminar tu cuenta?</h3>
            <p style="color: var(--text-muted); margin-bottom: 20px; line-height: 1.5; font-size: 0.95rem; width: 100%; white-space: normal; word-wrap: break-word;">
                Esta acción es irreversible. Escribe tu correo electrónico <b>(<span id="delete-email-verify" style="color: #fff;"></span>)</b> para confirmar.
            </p>
            
            <input type="email" id="confirm-email-input" class="input-dark" placeholder="Escribe tu correo..." style="margin-bottom: 25px; text-align: center;" />

            <div style="display: flex; gap: 15px; justify-content: center; width: 100%;">
                <button type="button" onclick="window.closeConfirmModal()" class="btn-secondary">Cancelar</button>
                <button type="button" id="btn-confirm-delete" onclick="window.deleteMyAccount()" class="btn-danger-solid">Eliminar Definitivamente</button>
            </div>
        </div>
    </div>

    <script>
        import { createClient } from '@supabase/supabase-js'
        
        const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
        let currentUserId = null;
        let currentUserEmail = null;

        window.showToast = (msg, isError = false) => {
            const t = document.getElementById('toast-container');
            t.innerText = msg;
            t.className = 'toast show' + (isError ? ' error' : '');
            setTimeout(() => t.classList.remove('show'), 4000);
        };

        async function init() {
            const { data: authData } = await supabase.auth.getSession();
            if (!authData?.session?.user) {
                window.location.replace('/');
                return;
            }

            currentUserEmail = authData.session.user.email;
            currentUserId = authData.session.user.id;
            document.body.classList.add('auth-ok');

            const { data: profile } = await supabase.from('perfiles').select('*').eq('email', currentUserEmail).maybeSingle();
            
            if (profile?.rol === 'admin' || profile?.rol === 'Administrador') {
                window.location.replace('/admin');
                return;
            }

            const nameDisplay = (profile?.nombre && profile.nombre.trim() !== '') ? profile.nombre : currentUserEmail;
            const initialLetter = nameDisplay.charAt(0).toUpperCase();

            const avatarContainer = document.getElementById('u-avatar');
            const savedAvatar = profile?.avatar;
            
            if (savedAvatar && (savedAvatar.startsWith('http://') || savedAvatar.startsWith('https://'))) {
                if (avatarContainer) {
                    avatarContainer.innerHTML = `<img src="${savedAvatar}" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />`;
                    avatarContainer.style.background = 'transparent';
                }
                document.getElementById('aj-avatar-img').src = savedAvatar;
                document.getElementById('aj-avatar-preview').style.display = 'block';
            } else {
                if (avatarContainer) {
                    avatarContainer.innerHTML = savedAvatar ? savedAvatar.toUpperCase().substring(0, 2) : initialLetter;
                    avatarContainer.style.background = 'var(--color-accent)';
                }
            }

            const uNameElement = document.getElementById('u-name');
            if (uNameElement) {
                uNameElement.innerHTML = `
                    <div style="font-weight: 600; font-size: 0.9rem; color: var(--color-accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${nameDisplay}</div>
                    <div style="font-weight: 400; font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Usuario</div>
                `;
            }

            document.getElementById('aj-nombre').value = profile?.nombre || '';
            document.getElementById('aj-avatar').value = profile?.avatar || '';
            document.getElementById('aj-email').value = currentUserEmail;
            document.getElementById('delete-email-verify').innerText = currentUserEmail;
        }

        document.getElementById('aj-avatar').addEventListener('input', (e) => {
            const val = e.target.value.trim();
            const preview = document.getElementById('aj-avatar-preview');
            const img = document.getElementById('aj-avatar-img');
            if (val.startsWith('http://') || val.startsWith('https://')) {
                img.src = val;
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });

        window.saveProfile = async (e) => {
            e.preventDefault();

            const btn = document.getElementById('btn-save-profile');
            btn.innerText = 'Guardando...'; btn.disabled = true;

            const nombreVal = document.getElementById('aj-nombre').value.trim();
            const avatarVal = document.getElementById('aj-avatar').value.trim();

            try {
                // Upsert usado en lugar de Update puro para mitigar race-conditions
                const { error } = await supabase.from('perfiles').upsert({
                    email: currentUserEmail,
                    nombre: nombreVal || null,
                    avatar: avatarVal || null
                }, { onConflict: 'email' });

                if (error) throw error;
                
                window.showToast("Perfil actualizado correctamente.");
                
                const nameDisplay = (nombreVal && nombreVal.trim() !== '') ? nombreVal : currentUserEmail;
                
                const uNameElement = document.getElementById('u-name');
                if (uNameElement) {
                    uNameElement.innerHTML = `
                        <div style="font-weight: 600; font-size: 0.9rem; color: var(--color-accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${nameDisplay}</div>
                        <div style="font-weight: 400; font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Usuario</div>
                    `;
                }
                
                const avatarContainer = document.getElementById('u-avatar');
                if (avatarContainer) {
                    if (avatarVal && (avatarVal.startsWith('http://') || avatarVal.startsWith('https://'))) {
                        avatarContainer.innerHTML = `<img src="${avatarVal}" style="width: 100%; height: 100%; object-fit: cover;" />`;
                        avatarContainer.style.background = 'transparent';
                    } else {
                        avatarContainer.innerHTML = avatarVal ? avatarVal.toUpperCase().substring(0, 2) : nameDisplay.charAt(0).toUpperCase();
                        avatarContainer.style.background = 'var(--color-accent)';
                    }
                }

            } catch (err) {
                window.showToast("Error: " + err.message, true);
            } finally {
                btn.innerText = 'Guardar Perfil'; btn.disabled = false;
            }
        };

        window.saveSecurity = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-security');
            btn.innerText = 'Guardando...'; btn.disabled = true;

            const newEmail = document.getElementById('aj-email').value.trim();
            const newPass = document.getElementById('aj-pass').value.trim();

            let mensajes = [];

            try {
                if (newEmail !== currentUserEmail) {
                    const { error } = await supabase.auth.updateUser({ email: newEmail });
                    if (error) throw error;
                    mensajes.push("Email actualizado (sigue las instrucciones en tu bandeja de entrada).");
                }

                if (newPass) {
                    const { error } = await supabase.auth.updateUser({ password: newPass });
                    if (error) throw error;
                    document.getElementById('aj-pass').value = '';
                    mensajes.push("Contraseña actualizada con éxito.");
                }

                if (mensajes.length > 0) {
                    window.showToast(mensajes.join(" "));
                } else {
                    window.showToast("No se han detectado cambios de seguridad.");
                }
            } catch (err) {
                window.showToast("Error: " + err.message, true);
            } finally {
                btn.innerText = 'Actualizar Seguridad'; btn.disabled = false;
            }
        };

        window.logoutGlobal = async () => {
            try {
                await supabase.auth.signOut();
                localStorage.clear();
                window.location.replace('/');
            } catch (e) {
                window.showToast("Error al cerrar sesiones.", true);
            }
        };

        window.logout = async () => {
            document.cookie = "sb-access-token=; path=/; max-age=0;";
            document.cookie = "sb-refresh-token=; path=/; max-age=0;";
            localStorage.clear();
            await supabase.auth.signOut();
            window.location.replace('/');
        };

        window.confirmDeleteAccount = () => {
            document.getElementById('confirm-email-input').value = '';
            document.getElementById('confirm-modal').classList.add('active');
        };

        window.closeConfirmModal = () => {
            document.getElementById('confirm-modal').classList.remove('active');
        };

        window.deleteMyAccount = async () => {
            const inputEmail = document.getElementById('confirm-email-input').value.trim();
            const btn = document.getElementById('btn-confirm-delete');

            if (inputEmail !== currentUserEmail) {
                window.showToast("El correo no coincide. Por favor, escríbelo correctamente.", true);
                return;
            }

            btn.innerText = 'Eliminando...'; btn.disabled = true;

            try {
                const res = await fetch('/api/usuarios', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: currentUserId })
                });

                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.error || 'Error en el servidor al eliminar.');
                }

                localStorage.clear();
                await supabase.auth.signOut();
                window.location.replace('/');
                
            } catch (err) {
                window.showToast("Error: " + err.message, true);
                btn.innerText = 'Eliminar Definitivamente'; btn.disabled = false;
            }
        };

        init();
    </script>
</Layout>
