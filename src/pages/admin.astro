---
// src/pages/admin.astro
import Layout from '../layouts/Layout.astro';
import MenuLateral from '../components/MenuLateral.astro';
export const prerender = false;
---

<Layout title="Panel de Control | Filmoteca">
    <MenuLateral modoSecundario={true}>
        <div class="section-label" style="margin-top: 10px;">Panel de Control</div>
        
        <div id="nav-content" class="nav-link active" onclick="window.switchTab('content')">
            <span>🎬 Gestión de Contenido</span>
        </div>

        <div id="nav-users" class="nav-link" onclick="window.switchTab('users')">
            <span>👥 Gestión de Usuarios</span>
        </div>
    </MenuLateral>

    <main>
        <section id="view-content" class="admin-view active">
            <div class="header-bar">
                <h2 id="view-title" class="view-title-main">Gestión de<span>Contenido</span></h2>
                
                <div class="header-actions">
                    <div style="background: #1a1a1a; border-radius: 8px; display: flex; padding: 4px; border: 1px solid var(--border-color);">
                        <button id="btn-mode-tmdb" onclick="window.setSearchMode('tmdb')" style="background: var(--color-accent); color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 0.85rem; font-family: inherit;">➕ Nuevo</button>
                        <button id="btn-mode-local" onclick="window.setSearchMode('local')" style="background: transparent; color: var(--text-muted); border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 0.85rem; font-family: inherit;">✏️ Modificar Existente</button>
                    </div>

                    <div class="search-box">
                        <input type="text" id="content-search-input" placeholder="Buscar para añadir nuevo contenido..." autocomplete="off"/>
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                        </svg>
                    </div>
                </div>
            </div>
            <div id="grid-content" class="film-grid">
                <div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">
                    Escribe en el buscador para encontrar nuevo contenido.
                </div>
            </div>
        </section>

        <section id="view-users" class="admin-view" style="display: none;">
            <div class="header-bar">
                <h2 class="view-title-main">Gestión de<span>Usuarios</span></h2>
                <button onclick="window.openUserModal()" class="btn-primary">➕ Nuevo Usuario</button>
            </div>
            <div id="grid-users" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 20px; padding-top: 10px;"></div>
        </section>
    </main>

    <div id="toast-container" class="toast"></div>

    <div id="content-modal" class="modal-overlay" onclick="if(event.target === this) window.closeModal('content-modal')">
        <div class="modal-content" style="max-width: 900px; padding: 40px;">
            <div class="modal-close" onclick="window.closeModal('content-modal')">✖</div>
            
            <div class="modal-left">
                <img id="modal-content-poster" class="modal-poster" src="" alt="Poster" />
            </div>
            
            <div class="modal-right">
                <div class="modal-section-title" id="modal-content-header" style="margin-top: 0; margin-bottom: 5px;">Añadir a la Filmoteca</div>
                <div id="modal-content-title" class="modal-title" style="font-size: 1.8rem; margin-bottom: 25px;">Cargando...</div>
                
                <form id="form-content" onsubmit="window.saveContent(event)">
                    <input type="hidden" id="fc-id" />
                    <input type="hidden" id="fc-caratula" />
                    <input type="hidden" id="fc-tmdb-id" />
                    
                    <div style="background: #222; padding: 15px; border-radius: 8px; border: 1px dashed var(--color-accent); margin-bottom: 25px;">
                        <label class="input-label" style="color: var(--color-accent);">Búsqueda de sinopsis y reparto</label>
                        <div style="position: relative; width: 100%;">
                            <div style="display: flex; gap: 10px;">
                                <input type="text" id="fc-tmdb-search" class="input-dark" placeholder="Buscar título original..." autocomplete="off" oninput="window.searchTmdbLink(this.value)" onkeydown="if(event.key === 'Enter') event.preventDefault()" />
                                <button type="button" onclick="window.clearTmdbLink()" class="btn-secondary" style="padding: 0 15px;">Revincular</button>
                            </div>
                            <div id="fc-tmdb-results" class="tmdb-dropdown-container" style="display: none;"></div>
                        </div>
                        <div id="fc-tmdb-status" style="font-size: 0.8rem; margin-top: 8px; color: #2ecc71; display: none; font-weight: 600;">✅ Vinculado al ID original: <span id="fc-tmdb-id-display"></span></div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                        <div>
                            <label class="input-label">Título Local</label>
                            <input type="text" id="fc-titulo" required class="input-dark" />
                        </div>
                        <div>
                            <label class="input-label">Año</label>
                            <input type="number" id="fc-anio" required class="input-dark" />
                        </div>
                        <div>
                            <label class="input-label">Duración (ej. 2h 15m)</label>
                            <input type="text" id="fc-duracion" class="input-dark" />
                        </div>
                        <div>
                            <label class="input-label">Categoría</label>
                            <select id="fc-categoria" required class="input-dark">
                                <option value="Cine">Cine</option>
                                <option value="Clasico">Clásico</option>
                                <option value="Animacion">Animación</option>
                                <option value="Documentales">Documentales</option>
                                <option value="Series">Series</option>
                                <option value="Shows">Shows</option>
                            </select>
                        </div>
                        <div>
                            <label class="input-label">Resolución</label>
                            <select id="fc-resolucion" required class="input-dark">
                                <option value="UHD">UHD</option>
                                <option value="FHD" selected>FHD</option>
                                <option value="HD">HD</option>
                                <option value="SD">SD</option>
                            </select>
                        </div>
                        <div>
                            <label class="input-label">Audio</label>
                            <input type="text" id="fc-audio" required class="input-dark" list="audio-list" autocomplete="off" placeholder="Selecciona o escribe..." />
                            <datalist id="audio-list"></datalist>
                        </div>
                        <div>
                            <label class="input-label">Tamaño (GB)</label>
                            <input type="number" step="0.01" id="fc-tamano" required class="input-dark" />
                        </div>
                        <div>
                            <label class="input-label">Saga / Serie</label>
                            <input type="text" id="fc-saga" class="input-dark" placeholder="Ej: Harry Potter" />
                        </div>
                        <div>
                            <label class="input-label">Capítulos (Series)</label>
                            <input type="number" id="fc-capitulos" class="input-dark" />
                        </div>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; gap: 10px; margin-top: 20px;">
                        <div>
                            <button type="button" id="btn-delete-content" onclick="window.deleteContent()" class="btn-danger-solid" style="display: none;">🗑️ Eliminar</button>
                        </div>
                        <div style="display: flex; gap: 15px;">
                            <button type="button" onclick="window.closeModal('content-modal')" class="btn-secondary">Cancelar</button>
                            <button type="submit" id="btn-save-content" class="btn-primary">💾 Guardar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="admin-user-edit-modal" class="modal-overlay" style="z-index: 9999;" onclick="if(event.target === this) window.closeModal('admin-user-edit-modal')">
        <div class="modal-content" style="max-width: 700px; padding: 40px; flex-direction: column;">
            <div class="modal-close" onclick="window.closeModal('admin-user-edit-modal')">✖</div>
            <h3 id="modal-user-header" class="modal-title" style="margin-bottom: 25px; font-size: 1.8rem;">Añadir Usuario</h3>
            
            <div id="modal-user-avatar-preview" style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; margin-bottom: 20px; display: none; border: 2px solid var(--color-accent);">
                <img id="mu-avatar-img" src="" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            
            <form id="form-user" onsubmit="window.saveUser(event)">
                <input type="hidden" id="fu-id" />
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                    <div>
                        <label class="input-label">Email</label>
                        <input type="email" id="fu-email" required class="input-dark" />
                    </div>

                    <div>
                        <label class="input-label">Nombre / Alias (Opcional)</label>
                        <input type="text" id="fu-nombre" class="input-dark" placeholder="Ej: Cinéfilo99" />
                    </div>
                    
                    <div>
                        <label class="input-label">Rol</label>
                        <select id="fu-rol" required class="input-dark">
                            <option value="user">Usuario</option>
                            <option value="admin">Administrador</option>
                        </select>
                        <span id="fu-rol-help" style="display: none; font-size: 0.75rem; color: #e74c3c; margin-top: 5px; font-weight: 600;">No puedes quitarle el rol a este usuario.</span>
                    </div>

                    <div>
                        <label class="input-label">URL Avatar (Opcional)</label>
                        <input type="text" id="fu-avatar" class="input-dark" placeholder="Letra autogenerada si vacío" />
                    </div>
                </div>
                
                <div style="display: flex; justify-content: space-between; gap: 10px;">
                    <div>
                        <button type="button" id="btn-delete-user" onclick="window.deleteUser()" class="btn-danger-solid" style="display: none;">🗑️ Eliminar</button>
                    </div>
                    <div style="display: flex; gap: 15px;">
                        <button type="button" onclick="window.closeModal('admin-user-edit-modal')" class="btn-secondary">Cancelar</button>
                        <button type="submit" id="btn-save-user" class="btn-primary">💾 Guardar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="confirm-modal" class="modal-overlay" style="z-index: 10000;" onclick="if(event.target === this) window.closeConfirmModal()">
        <div class="modal-content" style="max-width: 420px; width: 90%; padding: 30px; text-align: center; flex-direction: column; align-items: center; box-sizing: border-box; border-color: #e74c3c;">
            <div style="font-size: 3rem; margin-bottom: 15px; line-height: 1;">⚠️</div>
            <h3 class="modal-title" style="margin-top: 0; margin-bottom: 10px; font-size: 1.5rem; width: 100%;">Confirmar Acción</h3>
            <p id="confirm-msg" style="color: var(--text-muted); margin-bottom: 30px; line-height: 1.5; font-size: 1rem; width: 100%; white-space: normal; word-wrap: break-word;">¿Estás seguro?</p>
            <div style="display: flex; gap: 15px; justify-content: center; width: 100%;">
                <button type="button" onclick="window.closeConfirmModal()" class="btn-secondary">Cancelar</button>
                <button type="button" id="btn-confirm-action" class="btn-danger-solid">Eliminar</button>
            </div>
        </div>
    </div>

    <script>
        import { createClient } from '@supabase/supabase-js'
        
        const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
        const tmdbKey = import.meta.env.PUBLIC_TMDB_KEY; 

        let DATA_DB = [];
        let DATA_USERS = [];
        let searchMode = 'tmdb'; 
        let searchTimeout = null;
        let linkSearchTimeout = null;
        let pendingConfirmCallback = null;

        window.showToast = (msg, isError = false) => {
            const t = document.getElementById('toast-container');
            t.innerText = msg;
            t.className = 'toast show' + (isError ? ' error' : '');
            setTimeout(() => t.classList.remove('show'), 4000);
        };

        window.showConfirm = (msg, callback) => {
            document.getElementById('confirm-msg').innerText = msg;
            pendingConfirmCallback = callback;
            document.getElementById('confirm-modal').classList.add('active');
        };

        window.closeConfirmModal = () => {
            document.getElementById('confirm-modal').classList.remove('active');
            pendingConfirmCallback = null;
        };

        document.getElementById('btn-confirm-action').addEventListener('click', () => {
            if (pendingConfirmCallback) pendingConfirmCallback();
            window.closeConfirmModal();
        });

        async function init() {
            const email = await checkAdminAuth();
            if (!email) return;

            await fetchData();
            checkUrlParams();
            renderUsers();
            populateAudioList(); 
        }

        async function checkAdminAuth() {
            const email = localStorage.getItem('user_email');
            if (!email) { window.location.replace('/'); return null; }
            
            const { data: profile } = await supabase.from('perfiles').select('rol, nombre, avatar').eq('email', email).maybeSingle();
            const role = (profile?.rol || 'User').toLowerCase().trim();
            
            if (role !== 'admin') {
                alert("Acceso denegado: Solo administradores.");
                window.location.replace('/dashboard');
                return null;
            }

            document.body.classList.add('auth-ok');
            return email;
        }

        window.switchTab = (tabId) => {
            document.querySelectorAll('.admin-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            
            document.getElementById(`view-${tabId}`).style.display = 'block';
            document.getElementById(`nav-${tabId}`).classList.add('active');
            
            if (tabId === 'content') {
                document.getElementById('content-search-input').focus();
            }
        };

        async function fetchData() {
            const { data: dbData, error: dbError } = await supabase.from('filmoteca').select('*');
            if (dbError) console.error("Error cargando filmoteca:", dbError);
            DATA_DB = dbData || [];
            
            const { data: uData } = await supabase.from('perfiles').select('*');
            DATA_USERS = uData || [];
        }

        function populateAudioList() {
            const audioSet = new Set();
            DATA_DB.forEach(p => { if(p.audio) audioSet.add(p.audio.trim().toUpperCase()); });
            ['AC3', 'DTS', 'TRUE-HD', 'ATMOS'].forEach(a => audioSet.add(a));
            
            const datalist = document.getElementById('audio-list');
            datalist.innerHTML = Array.from(audioSet).sort().map(a => `<option value="${a}">`).join('');
        }

        function checkUrlParams() {
            const params = new URLSearchParams(window.location.search);
            const editId = params.get('edit');
            if (editId) {
                window.switchTab('content');
                window.setSearchMode('local');
                const p = DATA_DB.find(x => String(x.id) === String(editId));
                if (p) {
                    window.openContentModal(p, 'edit');
                    document.getElementById('content-search-input').value = p.titulo;
                    renderLocalGrid([p]);
                }
                window.history.replaceState({}, document.title, "/admin");
            }
        }

        window.closeModal = (modalId) => {
            document.getElementById(modalId).classList.remove('active');
            if (modalId === 'content-modal') {
                document.getElementById('fc-tmdb-results').style.display = 'none';
            }
        };

        function normalizeString(str) {
            return (str || '').toString().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^\w\s]/gi, '').replace(/\s+/g, ' ').trim().toLowerCase();
        }

        window.setSearchMode = (mode) => {
            searchMode = mode;
            const btnTmdb = document.getElementById('btn-mode-tmdb');
            const btnLocal = document.getElementById('btn-mode-local');
            const searchInput = document.getElementById('content-search-input');
            const gridContainer = document.getElementById('grid-content');

            searchInput.value = '';
            
            if (mode === 'tmdb') {
                btnTmdb.style.background = 'var(--color-accent)'; btnTmdb.style.color = 'white';
                btnLocal.style.background = 'transparent'; btnLocal.style.color = 'var(--text-muted)';
                searchInput.placeholder = 'Buscar para añadir nuevo contenido...';
                gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Escribe en el buscador para encontrar nuevo contenido.</div>`;
            } else {
                btnLocal.style.background = 'var(--color-accent)'; btnLocal.style.color = 'white';
                btnTmdb.style.background = 'transparent'; btnTmdb.style.color = 'var(--text-muted)';
                searchInput.placeholder = 'Buscar para modificar tu contenido local...';
                gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Escribe en el buscador para localizar contenido en tu base de datos.</div>`;
            }
        };

        document.getElementById('content-search-input').addEventListener('input', (e) => {
            const query = e.target.value.trim();
            if (searchTimeout) clearTimeout(searchTimeout);

            const gridContainer = document.getElementById('grid-content');

            if (query === '') {
                if (searchMode === 'local') {
                    gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Escribe en el buscador para localizar contenido en tu base de datos.</div>`;
                } else {
                    gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Escribe en el buscador para encontrar nuevo contenido.</div>`;
                }
                return;
            }

            if (searchMode === 'local') {
                const queryNorm = normalizeString(query);
                let filtered = DATA_DB.filter(p => normalizeString(p.titulo).includes(queryNorm) || normalizeString(p.saga).includes(queryNorm));
                filtered.sort((a, b) => (a.anio || 0) - (b.anio || 0));
                renderLocalGrid(filtered);
            } else {
                searchTimeout = setTimeout(() => searchTMDB(query), 500);
            }
        });

        async function searchTMDB(query) {
            const gridContainer = document.getElementById('grid-content');
            gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--color-accent); padding: 60px 0; font-size: 1.1rem;">Buscando "${query}" en TMDB...</div>`;
            try {
                const [movieRes, tvRes] = await Promise.all([
                    fetch(`https://api.themoviedb.org/3/search/movie?api_key=${tmdbKey}&query=${encodeURIComponent(query)}&language=es-ES`),
                    fetch(`https://api.themoviedb.org/3/search/tv?api_key=${tmdbKey}&query=${encodeURIComponent(query)}&language=es-ES`)
                ]);
                const movieData = await movieRes.json();
                const tvData = await tvRes.json();
                
                const localTitles = DATA_DB.map(d => normalizeString(d.titulo));

                const newMovies = (movieData.results || []).filter(m => !localTitles.includes(normalizeString(m.title)));
                const newTv = (tvData.results || []).filter(t => !localTitles.includes(normalizeString(t.name)));
                
                const moviesHTML = newMovies.map(m => generateCardHTML(m, 'tmdb_movie'));
                const tvHTML = newTv.map(t => generateCardHTML(t, 'tmdb_tv'));
                const combinedHTML = [...moviesHTML, ...tvHTML].join('');
                
                if (combinedHTML) {
                    gridContainer.innerHTML = combinedHTML;
                } else {
                    gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Todo lo encontrado ya está en tu filmoteca o no hay resultados.</div>`;
                }
            } catch (e) {
                gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #e74c3c;">Error al conectar con TMDB.</div>`;
            }
        }

        function renderLocalGrid(items) {
            const gridContainer = document.getElementById('grid-content');
            if(items.length === 0) {
                gridContainer.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">No hay coincidencias en tu catálogo.</div>`;
                return;
            }
            gridContainer.innerHTML = items.map(p => generateCardHTML(p, 'local')).join('');
        }

        function generateCardHTML(item, type) {
            let title, year, posterUrl, clickData, badgeHTML = '', durHTML = '';
            
            if (type === 'local') {
                title = item.titulo || 'Sin Título';
                year = item.anio || '----';
                
                posterUrl = item.poster_url || item.caratula || item.poster_path || '';
                if (typeof posterUrl === 'string') posterUrl = posterUrl.trim();
                if (posterUrl && (posterUrl.startsWith('/') || !posterUrl.startsWith('http'))) {
                    posterUrl = `https://image.tmdb.org/t/p/w500${posterUrl}`;
                } else if (!posterUrl) {
                    posterUrl = 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
                }

                const resText = item.resolucion || item.calidad || 'SD';
                const audioText = item.audio ? item.audio.trim().toUpperCase() : 'AC3';
                const gbText = item.tamano_gb || item.tamano || 0;

                badgeHTML = `
                    <div class="card-tag-badge">${resText}</div>
                    <div class="card-audio-badge">${audioText}</div>
                `;
                
                durHTML = `
                    <div class="meta-line"><span>Duración:</span><span class="val">${item.duracion || '----'}</span></div>
                    <div class="meta-line"><span>Tamaño:</span><span class="val gb">${gbText} GB</span></div>
                `;

                clickData = `window.openContentModal('${item.id}', 'edit')`;
                
                return `
                    <div class="film-card" onclick="${clickData}" style="border: 2px dashed var(--border-color); transition: 0.3s;" onmouseover="this.style.borderColor='var(--color-accent)'" onmouseout="this.style.borderColor='var(--border-color)'">
                        <div class="poster-container">
                            <img src="${posterUrl}" class="poster-img" alt="${title}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300'"/>
                            ${badgeHTML}
                        </div>
                        <div class="card-details">
                            <div class="card-name">${title}</div>
                            <div class="card-meta-box">
                                <div class="meta-line"><span>Año:</span><span class="val">${year}</span></div>
                                ${durHTML}
                                <div class="meta-line" style="justify-content: center; margin-top: 10px;">
                                    <span style="color: var(--color-accent); font-weight: bold;">✏️ Editar Contenido</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

            } else {
                const isTv = type === 'tmdb_tv';
                title = isTv ? item.name : item.title;
                const date = isTv ? item.first_air_date : item.release_date;
                year = date ? date.split('-')[0] : 'N/A';
                posterUrl = item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
                
                const safeItem = encodeURIComponent(JSON.stringify({ ...item, isTv }));
                clickData = `window.openContentModal(JSON.parse(decodeURIComponent('${safeItem}')), 'add')`;

                return `
                    <div class="film-card" onclick="${clickData}" style="border: 2px dashed var(--border-color); transition: 0.3s;" onmouseover="this.style.borderColor='var(--color-accent)'" onmouseout="this.style.borderColor='var(--border-color)'">
                        <div class="poster-container">
                            <img src="${posterUrl}" class="poster-img" alt="${title}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300'"/>
                        </div>
                        <div class="card-details">
                            <div class="card-name">${title}</div>
                            <div class="card-meta-box">
                                <div class="meta-line"><span>Año:</span><span class="val">${year}</span></div>
                                <div class="meta-line" style="justify-content: center; margin-top: 10px;">
                                    <span style="color: var(--color-accent); font-weight: bold;">➕ Añadir a Filmoteca</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }
        }

        window.openContentModal = async (dataOrId, action) => {
            const isEdit = action === 'edit';
            let data = dataOrId;
            
            if (isEdit && typeof dataOrId === 'string') {
                data = DATA_DB.find(x => String(x.id) === String(dataOrId));
            }
            if (!data) return;
            
            document.getElementById('modal-content-header').innerText = isEdit ? 'Modificar Filmoteca' : 'Añadir a Filmoteca';
            document.getElementById('btn-delete-content').style.display = isEdit ? 'block' : 'none';

            const tmdbId = isEdit ? (data.tmdb_id || '') : (data.id || '');
            document.getElementById('fc-tmdb-id').value = tmdbId;
            
            const statusDiv = document.getElementById('fc-tmdb-status');
            const searchInput = document.getElementById('fc-tmdb-search');
            
            if (tmdbId) {
                statusDiv.style.display = 'block';
                document.getElementById('fc-tmdb-id-display').innerText = tmdbId;
                searchInput.placeholder = 'Buscar para cambiar vinculación...';
            } else {
                statusDiv.style.display = 'none';
                searchInput.placeholder = 'Buscar título original...';
            }
            document.getElementById('fc-tmdb-results').style.display = 'none';
            document.getElementById('fc-tmdb-search').value = '';

            if (isEdit) {
                let pUrl = data.poster_url || data.caratula || data.poster_path || '';
                if (typeof pUrl === 'string') pUrl = pUrl.trim();
                if (pUrl && (pUrl.startsWith('/') || !pUrl.startsWith('http'))) pUrl = `https://image.tmdb.org/t/p/w500${pUrl}`;
                
                document.getElementById('modal-content-poster').src = pUrl || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
                document.getElementById('modal-content-title').innerText = data.titulo;
                
                document.getElementById('fc-id').value = data.id;
                document.getElementById('fc-caratula').value = data.poster_url || data.caratula || '';
                document.getElementById('fc-titulo').value = data.titulo || '';
                document.getElementById('fc-anio').value = data.anio || '';
                document.getElementById('fc-duracion').value = data.duracion || '';
                document.getElementById('fc-categoria').value = data.categoria || 'Cine';
                document.getElementById('fc-resolucion').value = data.resolucion || data.calidad || 'FHD';
                document.getElementById('fc-audio').value = data.audio ? data.audio.trim().toUpperCase() : '';
                document.getElementById('fc-tamano').value = data.tamano_gb || data.tamano || 0;
                document.getElementById('fc-saga').value = data.saga || '';
                document.getElementById('fc-capitulos').value = data.capitulos || '';
            } else {
                const title = data.isTv ? data.name : data.title;
                const date = data.isTv ? data.first_air_date : data.release_date;
                const year = date ? date.split('-')[0] : '';
                
                document.getElementById('modal-content-poster').src = data.poster_path ? `https://image.tmdb.org/t/p/w500${data.poster_path}` : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
                document.getElementById('modal-content-title').innerText = title;
                
                document.getElementById('fc-id').value = '';
                document.getElementById('fc-caratula').value = data.poster_path || '';
                document.getElementById('fc-titulo').value = title;
                document.getElementById('fc-anio').value = year;
                document.getElementById('fc-duracion').value = '';
                document.getElementById('fc-categoria').value = data.isTv ? 'Series' : 'Cine';
                document.getElementById('fc-resolucion').value = 'FHD';
                document.getElementById('fc-audio').value = '';
                document.getElementById('fc-tamano').value = '';
                document.getElementById('fc-saga').value = '';
                document.getElementById('fc-capitulos').value = '';

                if (!data.isTv && data.id) {
                    try {
                        const dRes = await fetch(`https://api.themoviedb.org/3/movie/${data.id}?api_key=${tmdbKey}&language=es-ES`);
                        const dData = await dRes.json();
                        if (dData.runtime) {
                            const h = Math.floor(dData.runtime / 60);
                            const m = dData.runtime % 60;
                            document.getElementById('fc-duracion').value = h > 0 ? `${h}h ${m}m` : `${m}m`;
                        }
                    } catch (e) {}
                }
            }
            document.getElementById('content-modal').classList.add('active');
        };

        window.searchTmdbLink = (query) => {
            const resultsBox = document.getElementById('fc-tmdb-results');
            const q = query.trim();
            if (!q || (q.length < 3 && !/^\d+$/.test(q))) { 
                resultsBox.style.display = 'none';
                return; 
            }
            
            if (linkSearchTimeout) clearTimeout(linkSearchTimeout);
            linkSearchTimeout = setTimeout(async () => {
                try {
                    let combined = [];
                    const isIdSearch = /^\d+$/.test(q);

                    if (isIdSearch) {
                        const [mRes, tRes] = await Promise.all([
                            fetch(`https://api.themoviedb.org/3/movie/${q}?api_key=${tmdbKey}&language=es-ES`).catch(() => null),
                            fetch(`https://api.themoviedb.org/3/tv/${q}?api_key=${tmdbKey}&language=es-ES`).catch(() => null)
                        ]);
                        
                        const mData = mRes && mRes.ok ? await mRes.json() : null;
                        const tData = tRes && tRes.ok ? await tRes.json() : null;
                        
                        if (mData && mData.id) combined.push({ ...mData, media_type: 'movie' });
                        if (tData && tData.id) combined.push({ ...tData, media_type: 'tv' });
                    } else {
                        const [movieRes, tvRes] = await Promise.all([
                            fetch(`https://api.themoviedb.org/3/search/movie?api_key=${tmdbKey}&query=${encodeURIComponent(q)}&language=es-ES`),
                            fetch(`https://api.themoviedb.org/3/search/tv?api_key=${tmdbKey}&query=${encodeURIComponent(q)}&language=es-ES`)
                        ]);
                        
                        const movieData = await movieRes.json();
                        const tvData = await tvRes.json();
                        
                        combined = [
                            ...(movieData.results || []).map(m => ({ ...m, media_type: 'movie' })),
                            ...(tvData.results || []).map(t => ({ ...t, media_type: 'tv' }))
                        ];
                    }

                    combined.sort((a, b) => (b.popularity || 0) - (a.popularity || 0));
                    const filtered = combined.slice(0, 3); // Límite de 3
                    
                    if (filtered.length === 0) {
                        resultsBox.innerHTML = '<div style="padding: 10px; color: var(--text-muted); text-align: center;">No se encontraron resultados.</div>';
                    } else {
                        const html = filtered.map(item => {
                            const title = item.title || item.name;
                            const date = item.release_date || item.first_air_date;
                            const year = date ? date.split('-')[0] : '';
                            const typeLabel = item.media_type === 'tv' ? 'Serie' : 'Película';
                            const thumbUrl = item.poster_path ? `https://image.tmdb.org/t/p/w92${item.poster_path}` : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
                            
                            const safeItem = encodeURIComponent(JSON.stringify(item));
                            
                            // Reutilizamos tus clases .tmdb-wish-*
                            return `
                                <div class="tmdb-wish-item" onclick="window.selectTmdbLink(JSON.parse(decodeURIComponent('${safeItem}')))">
                                    <img class="tmdb-wish-poster" src="${thumbUrl}" onerror="this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300'" />
                                    <div class="tmdb-wish-info" style="min-width: 0; flex: 1;">
                                        <span class="tmdb-wish-title" title="${title}">${title}</span>
                                        <span class="tmdb-wish-meta">${year} • ${typeLabel}</span>
                                    </div>
                                </div>
                            `;
                        }).join('');
                        resultsBox.innerHTML = html;
                    }
                    resultsBox.style.display = 'flex';
                } catch (e) {}
            }, 500);
        };

        window.selectTmdbLink = async (item) => {
            // 1. Guardar el ID de TMDB
            const tmdbInput = document.getElementById('fc-tmdb-id');
            tmdbInput.value = item.id;
            tmdbInput.setAttribute('value', item.id);
            
            // 2. Extraer y actualizar la información de la película/serie
            const isTv = item.media_type === 'tv';
            const title = isTv ? item.name : (item.title || item.name);
            const date = item.release_date || item.first_air_date;
            const year = date ? date.split('-')[0] : '';

            document.getElementById('fc-titulo').value = title;
            document.getElementById('fc-anio').value = year;
            document.getElementById('fc-categoria').value = isTv ? 'Series' : 'Cine';
            document.getElementById('modal-content-title').innerText = title; // Actualiza el título visual del modal
            
            // 3. Lógica de la carátula: Si NO hay carátula, pone la nueva. Si YA hay, la respeta.
            const caratulaInput = document.getElementById('fc-caratula');
            if (!caratulaInput.value || caratulaInput.value.trim() === '') {
                caratulaInput.value = item.poster_path || '';
                document.getElementById('modal-content-poster').src = item.poster_path 
                    ? `https://image.tmdb.org/t/p/w500${item.poster_path}` 
                    : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=300';
            }
            
            // 4. (Opcional) Consultar la duración exacta si es una película
            if (!isTv && item.id) {
                try {
                    const dRes = await fetch(`https://api.themoviedb.org/3/movie/${item.id}?api_key=${tmdbKey}&language=es-ES`);
                    const dData = await dRes.json();
                    if (dData.runtime) {
                        const h = Math.floor(dData.runtime / 60);
                        const m = dData.runtime % 60;
                        document.getElementById('fc-duracion').value = h > 0 ? `${h}h ${m}m` : `${m}m`;
                    }
                } catch (e) {
                    console.warn("No se pudo obtener la duración extra.");
                }
            }
            
            // 5. Restablecer la interfaz de búsqueda
            document.getElementById('fc-tmdb-status').style.display = 'block';
            document.getElementById('fc-tmdb-id-display').innerText = item.id;
            document.getElementById('fc-tmdb-results').style.display = 'none';
            document.getElementById('fc-tmdb-search').value = '';
            document.getElementById('fc-tmdb-search').placeholder = 'Buscar para cambiar vinculación...';
        };

        window.clearTmdbLink = () => {
            const tmdbInput = document.getElementById('fc-tmdb-id');
            tmdbInput.value = '';
            tmdbInput.removeAttribute('value');
            
            document.getElementById('fc-tmdb-status').style.display = 'none';
            document.getElementById('fc-tmdb-search').value = '';
            document.getElementById('fc-tmdb-search').placeholder = 'Buscar título original...';
        };

        document.addEventListener('click', (e) => {
            const linkResultsBox = document.getElementById('fc-tmdb-results');
            const linkInputField = document.getElementById('fc-tmdb-search');
            if (linkResultsBox && linkResultsBox.style.display === 'flex' && e.target !== linkInputField && !linkResultsBox.contains(e.target)) {
                linkResultsBox.style.display = 'none';
            }
        });

        window.saveContent = async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-content');
            btn.innerHTML = 'Guardando...'; btn.disabled = true;

            const id = document.getElementById('fc-id').value;
            const tmdbVal = document.getElementById('fc-tmdb-id').value;
            
            const payload = {
                titulo: document.getElementById('fc-titulo').value.trim(),
                anio: parseInt(document.getElementById('fc-anio').value) || null,
                duracion: document.getElementById('fc-duracion').value.trim(),
                categoria: document.getElementById('fc-categoria').value,
                resolucion: document.getElementById('fc-resolucion').value,
                audio: document.getElementById('fc-audio').value.trim(),
                tamano_gb: parseFloat(document.getElementById('fc-tamano').value) || 0,
                saga: document.getElementById('fc-saga').value.trim(),
                capitulos: document.getElementById('fc-capitulos').value ? parseInt(document.getElementById('fc-capitulos').value) : null,
                poster_url: document.getElementById('fc-caratula').value,
                // Aplicamos Number para mayor seguridad al guardarlo
                tmdb_id: tmdbVal ? Number(tmdbVal) : null 
            };

            try {
                if (id) {
                    const { error } = await supabase.from('filmoteca').update(payload).eq('id', id);
                    if (error) throw error;
                    window.showToast('¡Contenido actualizado con éxito!');
                } else {
                    payload.fecha_incorporacion = new Date().toISOString().split('T')[0];
                    
                    const { error } = await supabase.from('filmoteca').insert([payload]);
                    if (error) throw error;
                    window.showToast('¡Contenido añadido a tu filmoteca!');
                }
                
                window.closeModal('content-modal');
                await fetchData(); 
                populateAudioList(); 
                
                const searchVal = document.getElementById('content-search-input').value;
                if(searchMode === 'local') {
                    if (searchVal) {
                        const queryNorm = normalizeString(searchVal);
                        let filtered = DATA_DB.filter(p => normalizeString(p.titulo).includes(queryNorm) || normalizeString(p.saga).includes(queryNorm));
                        filtered.sort((a, b) => (a.anio || 0) - (b.anio || 0));
                        renderLocalGrid(filtered);
                    }
                } else {
                    document.getElementById('content-search-input').dispatchEvent(new Event('input'));
                }
            } catch (err) { 
                window.showToast('Error SQL: ' + err.message, true); 
            } finally { 
                btn.innerHTML = '💾 Guardar'; btn.disabled = false; 
            }
        };

        window.deleteContent = async () => {
            const id = document.getElementById('fc-id').value;
            if (!id) return;
            
            window.showConfirm("¿Seguro que quieres eliminar este contenido de tu filmoteca?", async () => {
                try {
                    const { error } = await supabase.from('filmoteca').delete().eq('id', id);
                    if (error) throw error;
                    
                    window.showToast("Contenido eliminado.");
                    window.closeModal('content-modal');
                    await fetchData();
                    
                    const searchVal = document.getElementById('content-search-input').value;
                    if(searchMode === 'local' && searchVal) {
                        const queryNorm = normalizeString(searchVal);
                        let filtered = DATA_DB.filter(p => normalizeString(p.titulo).includes(queryNorm) || normalizeString(p.saga).includes(queryNorm));
                        filtered.sort((a, b) => (a.anio || 0) - (b.anio || 0));
                        renderLocalGrid(filtered);
                    } else {
                        document.getElementById('grid-content').innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 60px 0; font-size: 1.1rem;">Escribe en el buscador para localizar contenido en tu base de datos.</div>`;
                    }
                } catch (err) { 
                    window.showToast('Error SQL: ' + err.message, true); 
                }
            });
        };

        // ---------------------------------------------------------
        // 2. GESTIÓN DE USUARIOS
        // ---------------------------------------------------------
        function renderUsers() {
            try {
                const grid = document.getElementById('grid-users');
                grid.innerHTML = DATA_USERS.map((u, index) => {
                    const roleStr = u.rol ? String(u.rol).toLowerCase().trim() : '';
                    const roleText = (roleStr === 'admin' || roleStr === 'administrador') ? 'Administrador' : 'Usuario';
                    const displayName = u.nombre ? `${u.nombre} (${u.email})` : u.email;
                    
                    let avatarHtml = '';
                    let bgStyle = 'var(--color-accent)';
                    const uAvatar = u.avatar ? String(u.avatar) : '';
                    
                    if (uAvatar && (uAvatar.startsWith('http://') || uAvatar.startsWith('https://'))) {
                        avatarHtml = `<img src="${uAvatar}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" />`;
                        bgStyle = 'transparent';
                    } else {
                        const initial = displayName ? displayName.charAt(0).toUpperCase() : '?';
                        avatarHtml = (uAvatar || initial).substring(0, 2);
                    }
                    
                    return `
                    <div class="user-card-admin" style="border-left: 4px solid var(--color-accent);">
                        <div style="width: 60px; height: 60px; background: ${bgStyle}; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 26px; color: white;">
                            ${avatarHtml}
                        </div>
                        <div style="flex: 1; overflow: hidden;">
                            <div style="font-weight: bold; font-size: 1.05rem; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${displayName}">${displayName}</div>
                            <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; margin-top: 5px;">${roleText}</div>
                        </div>
                        <div style="display:flex; gap: 10px;">
                            <button onclick="window.openUserModal(${index})" class="admin-edit-icon" title="Editar Perfil">✏️</button>
                        </div>
                    </div>
                    `;
                }).join('');
            } catch (error) {
                console.error("Error al renderizar usuarios:", error);
            }
        }

        window.openUserModal = (userIndex = null) => {
            try {
                let user = null;
                if (typeof userIndex === 'number' && DATA_USERS[userIndex]) {
                    user = DATA_USERS[userIndex];
                }
                
                document.getElementById('modal-user-header').innerText = user ? 'Editar Usuario' : 'Añadir Usuario';
                
                const avatarPreview = document.getElementById('modal-user-avatar-preview');
                const avatarImg = document.getElementById('mu-avatar-img');
                
                const uAvatar = user && user.avatar ? String(user.avatar) : '';
                if (uAvatar && (uAvatar.startsWith('http://') || uAvatar.startsWith('https://'))) {
                    avatarImg.src = uAvatar;
                    avatarPreview.style.display = 'block';
                } else {
                    avatarPreview.style.display = 'none';
                }
                
                const adminCount = DATA_USERS.filter(u => {
                    const r = u.rol ? String(u.rol).toLowerCase().trim() : '';
                    return r === 'admin' || r === 'administrador';
                }).length;
                
                let isOnlyAdmin = false;
                let normalizedRole = 'user';
                
                if (user) {
                    const uRole = user.rol ? String(user.rol).toLowerCase().trim() : '';
                    if (uRole === 'admin' || uRole === 'administrador') {
                        normalizedRole = 'admin';
                        if (adminCount <= 1) isOnlyAdmin = true;
                    }
                }

                const btnDelete = document.getElementById('btn-delete-user');
                const selectRol = document.getElementById('fu-rol');
                const rolHelp = document.getElementById('fu-rol-help');

                if (user) {
                    if (isOnlyAdmin) {
                        btnDelete.style.display = 'none';
                        selectRol.disabled = true;
                        rolHelp.style.display = 'block';
                    } else {
                        btnDelete.style.display = 'block';
                        selectRol.disabled = false;
                        rolHelp.style.display = 'none';
                    }
                } else {
                    btnDelete.style.display = 'none';
                    selectRol.disabled = false;
                    rolHelp.style.display = 'none';
                }
                
                document.getElementById('fu-id').value = user ? (user.id || '') : '';
                document.getElementById('fu-email').value = user ? (user.email || '') : '';
                document.getElementById('fu-nombre').value = user ? (user.nombre || '') : '';
                document.getElementById('fu-rol').value = normalizedRole;
                document.getElementById('fu-avatar').value = user ? (user.avatar || '') : '';
                
                document.getElementById('admin-user-edit-modal').classList.add('active');

            } catch (error) {
                alert("Se ha bloqueado la apertura por este error: " + error.message);
                console.error("Error detallado en openUserModal:", error);
            }
        };

        window.saveUser = async (e) => {
            e.preventDefault();
            const id = document.getElementById('fu-id').value;
            const emailVal = document.getElementById('fu-email').value.trim();
            const nombreVal = document.getElementById('fu-nombre').value.trim();
            
            let avatarVal = document.getElementById('fu-avatar').value.trim();
            if (!avatarVal && emailVal) {
                const referenceName = (nombreVal && nombreVal.trim() !== '') ? nombreVal : emailVal;
                avatarVal = referenceName.charAt(0).toUpperCase();
            }

            let roleVal = document.getElementById('fu-rol').value;
            if (id) {
                const user = DATA_USERS.find(u => String(u.id) === String(id));
                const adminCount = DATA_USERS.filter(u => {
                    const r = u.rol ? String(u.rol).toLowerCase().trim() : '';
                    return r === 'admin' || r === 'administrador';
                }).length;
                
                const uRole = user && user.rol ? String(user.rol).toLowerCase().trim() : '';
                if ((uRole === 'admin' || uRole === 'administrador') && adminCount <= 1) {
                    roleVal = 'admin'; 
                }
            }

            const payload = {
                id: id || null,
                email: emailVal,
                nombre: nombreVal || null,
                rol: roleVal,
                avatar: avatarVal
            };

            const btn = document.getElementById('btn-save-user');
            btn.innerHTML = 'Guardando...'; btn.disabled = true;

            try {
                const res = await fetch('/api/usuarios', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Error desconocido del servidor');
                
                let profileQuery = supabase
                    .from('perfiles')
                    .update({
                        nombre: nombreVal || null,
                        avatar: avatarVal || null
                    });
                    
                if (id) {
                    profileQuery = profileQuery.eq('id', id);
                } else {
                    profileQuery = profileQuery.eq('email', emailVal);
                }
                
                const { error: profileError } = await profileQuery;
                
                if (profileError) {
                    console.warn("No se pudieron guardar los extras del perfil de inmediato:", profileError);
                }

                window.showToast(data.message);
                window.closeModal('admin-user-edit-modal');
                await fetchData();
                renderUsers();

            } catch (err) {
                window.showToast('Error: ' + err.message, true);
            } finally {
                btn.innerHTML = '💾 Guardar'; btn.disabled = false;
            }
        };

        window.deleteUser = async () => {
            const id = document.getElementById('fu-id').value;
            if (!id) return;
            
            const user = DATA_USERS.find(u => String(u.id) === String(id));
            const adminCount = DATA_USERS.filter(u => {
                const r = u.rol ? String(u.rol).toLowerCase().trim() : '';
                return r === 'admin' || r === 'administrador';
            }).length;
            
            const uRole = user && user.rol ? String(user.rol).toLowerCase().trim() : '';
            if ((uRole === 'admin' || uRole === 'administrador') && adminCount <= 1) {
                window.showToast("No puedes eliminar al único administrador.", true);
                return;
            }

            window.showConfirm("¿Eliminar este perfil de forma permanente? Esta acción no se puede deshacer.", async () => {
                try {
                    const res = await fetch('/api/usuarios', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id })
                    });
                    
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Error al eliminar usuario');

                    window.showToast("Usuario eliminado correctamente.");
                    window.closeModal('admin-user-edit-modal');
                    await fetchData();
                    renderUsers();
                } catch (err) { window.showToast('Error: ' + err.message, true); }
            });
        };

        init();
    </script>
</Layout>
